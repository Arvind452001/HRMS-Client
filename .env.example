# Reference only - copy this file to client/.env for local development.
# The backend URL used by the app is read from VITE_API_URL at build time
# (see client/src/utils/baseUrlConfig.js). If unset, it falls back to
# http://localhost:5000/api for local dev.
#
# LOCAL:
# VITE_API_URL=http://localhost:5000/api
#
# PRODUCTION (Vercel): set VITE_API_URL as an Environment Variable in the
# Vercel project dashboard (not in this file, which isn't deployed) to your
# Render backend's /api URL, e.g.:
VITE_API_URL=https://your-backend.onrender.com/api
